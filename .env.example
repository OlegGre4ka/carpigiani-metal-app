POSTGRES_DB=carpigiani_metal_db
POSTGRES_USER=carpigiani_metal_user
POSTGRES_PASSWORD=replace_me

# Frontend addresses allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

# Admin panel (/fofkas-adminpanel). Admins are created on the first start.
# Secret for login tokens: a long random string, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_long_random_string
OLEH_ADMIN_EMAIL=
OLEH_ADMIN_PASSWORD=
FOFKA_ADMIN_EMAIL=
FOFKA_ADMIN_PASSWORD=

# AI in the admin panel ("Table" block → "Fill from a picture"). Free key:
# aistudio.google.com → Get API key. GEMINI_MODEL is optional (gemini-2.5-flash by default).
GEMINI_API_KEY=
GEMINI_MODEL=
